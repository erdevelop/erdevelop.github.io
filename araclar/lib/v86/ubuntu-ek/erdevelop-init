#!/bin/bash
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sys /sys 2>/dev/null
mount -t devtmpfs dev /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm && mount -t devpts devpts /dev/pts && mount -t tmpfs shm /dev/shm
mount -t tmpfs tmp /tmp; mount -t tmpfs run /run
hostname erdevelop
ip link set lo up 2>/dev/null
export HOME=/root TERM=xterm-256color LANG=C.UTF-8 LC_ALL=C.UTF-8 PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
[ -n "$TZ" ] && echo "$TZ" > /etc/erdevelop-tz
[ -n "$COLS" ] && echo "$COLS $ROWS" > /etc/erdevelop-size
cd /root
if [ "${COLS:-80}" -lt 70 ]; then cat /etc/motd.kisa; else cat /etc/motd; fi
while true; do setsid -c bash -l </dev/ttyS0 >/dev/ttyS0 2>&1; echo "Kabuk kapandı, yeniden açılıyor…"; done
