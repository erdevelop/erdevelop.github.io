#!/bin/busybox sh
/bin/busybox --install -s
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mount -t tmpfs tmp /tmp
hostname erdevelop
ifconfig lo 127.0.0.1 up 2>/dev/null
# Buyuk sistem: 9p uzerindeki Ubuntu kok dizinine gec
if [ "$BUYUK" = 1 ]; then
  mkdir -p /yeni
  if mount -t 9p -o trans=virtio,version=9p2000.L,cache=loose,msize=512000 host9p /yeni; then
    umount /proc /sys /dev/pts /tmp 2>/dev/null; umount /dev 2>/dev/null
    exec switch_root /yeni /sbin/erdevelop-init
  fi
  echo "Buyuk sistem baglanamadi, kucuk sisteme donuluyor."
fi
# Konsol'daki dosyalar 9p ile paylasilir
if mount -t 9p -o trans=virtio,version=9p2000.L host9p /mnt/konsol 2>/dev/null; then K=1; fi
export HOME=/root TERM=xterm-256color PATH=/bin:/sbin:/usr/bin:/usr/sbin
[ -n "$TZ" ] && export TZ && echo "$TZ" > /etc/TZ
cd /root
if [ "${COLS:-80}" -lt 70 ]; then cat /etc/motd.kisa; else cat /etc/motd; fi
echo
while true; do setsid cttyhack sh -l; echo "Kabuk kapandı, yeniden açılıyor…"; done
