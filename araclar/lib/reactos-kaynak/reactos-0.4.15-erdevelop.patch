diff --git a/base/system/userinit/livecd.c b/base/system/userinit/livecd.c
index a3b14ec3..e2887f17 100644
--- a/base/system/userinit/livecd.c
+++ b/base/system/userinit/livecd.c
@@ -645,6 +645,24 @@ LocaleDlgProc(
             CreateKeyboardLayoutList(GetDlgItem(hwndDlg, IDC_LAYOUTLIST));
             if (pState->Unattend->bEnabled)
             {
+                /* erdevelop: in unattended mode also select the keyboard layout.
+                   Look for the exact layout id first (0000041F = Turkish Q);
+                   matching by language alone may pick another layout (Turkish F). */
+                if (pState->Unattend->LocaleID)
+                {
+                    HWND hLay = GetDlgItem(hwndDlg, IDC_LAYOUTLIST);
+                    INT i, n = (INT)SendMessageW(hLay, CB_GETCOUNT, 0, 0);
+                    for (i = 0; i < n; i++)
+                    {
+                        if ((ULONG)SendMessageW(hLay, CB_GETITEMDATA, i, 0) == (ULONG)pState->Unattend->LocaleID)
+                        {
+                            SendMessageW(hLay, CB_SETCURSEL, i, 0);
+                            break;
+                        }
+                    }
+                    if (i == n)
+                        SelectKeyboardForLanguage(hLay, pState->Unattend->LocaleID);
+                }
                 // Advance to the next page
                 PostMessageW(hwndDlg, WM_COMMAND, MAKELONG(IDOK, BN_CLICKED), 0L);
             }
