diff --git a/sdk/cmake/gcc.cmake b/sdk/cmake/gcc.cmake
index df283873..65e8168c 100644
--- a/sdk/cmake/gcc.cmake
+++ b/sdk/cmake/gcc.cmake
@@ -573,7 +573,12 @@ execute_process(COMMAND ${GXX_EXECUTABLE} -print-file-name=libgcc.a OUTPUT_VARIA
